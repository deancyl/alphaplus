# Alphaplus 环境变量示例（复制为 .env 并按需修改）
# 注意：所有密钥只放这里，不要提交到仓库。

# --- 服务端口 ---------------------------------------------------------------
# 生产/日常
# PORT=60200
# 内部开发 / 集成测试（见 docs/DEV_PLAN_AI_PREDICTION.md）
# TEST_PORT=60100

# --- 数据诚实降级策略 -------------------------------------------------------
# false（默认）= 上游失败时声明"不可用"，绝不用模拟数据冒充真实。
# true          = 允许注入模拟数据（仍会带 is_simulated=true 标记）。
ALLOW_SIMULATED_FALLBACK=false

# --- LLM（AI 解读层）---------------------------------------------------------
# 不配置 LLM_API_KEY 时，/forecast 接口返回 enabled=false 且数值预测照常工作，
# 不会伪造任何 AI 解读。
# 兼容 OpenAI 及任何 OpenAI 格式的服务（如本地 vLLM / DeepSeek / 通义等）。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# chat -> /chat/completions ； responses -> /responses
LLM_API_STYLE=chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200

# --- CORS -------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:60201,http://127.0.0.1:60201
